{
  "name": "umn-gopher-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Independent five-campus bilingual campus assistant platform",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && node scripts/clean.mjs",
    "dev": "turbo run dev --parallel",
    "evaluate:ai": "cd apps/ai-knowledge && python -m ai_knowledge.evaluation",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "turbo run generate",
    "check:generated": "turbo run check:generated",
    "lint": "turbo run lint",
    "maintain:personal-vault": "pnpm --filter @umn-gopher-assistant/db maintain:personal-vault",
    "smoke:api": "node scripts/smoke-api.mjs",
    "smoke:catalog:live": "node scripts/smoke-public-catalog-live.mjs",
    "smoke:db": "node scripts/smoke-foundation-db.mjs",
    "smoke:identity": "node scripts/smoke-identity.mjs",
    "smoke:identity:reconcile-offline": "node infra/compose/keycloak/reconcile-realm.mjs --offline-retained-realm-smoke",
    "smoke:identity:device": "node apps/web/scripts/smoke-identity-device.mjs",
    "smoke:mcp:oauth": "node scripts/smoke-mcp-oauth.mjs",
    "smoke:personal-vault-maintenance": "node scripts/smoke-personal-vault-maintenance.mjs",
    "test": "turbo run test && vitest run scripts/verify-foundation.test.mjs && node --test scripts/smoke-mcp-oauth.test.mjs",
    "test:identity:device": "node --test apps/web/scripts/smoke-identity-device.test.mjs",
    "test:mcp:oauth": "node --test scripts/smoke-mcp-oauth.test.mjs",
    "test:unit": "vitest run",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm verify:node && pnpm verify:python",
    "verify:node": "pnpm verify:node-policy && pnpm verify:foundation && pnpm check:generated && pnpm lint && pnpm typecheck && pnpm test",
    "verify:python": "cd apps/ai-knowledge && python -m ruff check . && python -m ruff format --check . && python -m pytest -m \"not integration\" && python -m ai_knowledge.evaluation",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "verify:node-policy": "node scripts/verify-node-policy.mjs"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server@<2.0.10": "2.0.11",
      "fast-uri@>=3.0.0 <3.1.4": "3.1.4",
      "find-my-way@<=9.6.0": "9.7.0",
      "postcss": "8.5.19",
      "sharp@<0.35.0": "0.35.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.4",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "prettier": "3.7.4",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
