{
  "name": "umn-gopher-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Independent five-campus bilingual campus assistant platform",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.11.1"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && node scripts/clean.mjs",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "smoke:db": "node scripts/smoke-foundation-db.mjs",
    "test": "turbo run test",
    "test:unit": "vitest run",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm verify:foundation && pnpm lint && pnpm typecheck && pnpm test",
    "verify:foundation": "node scripts/verify-foundation.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.4",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.7.4",
    "turbo": "2.10.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.0",
    "vitest": "4.1.10"
  }
}
