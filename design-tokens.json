{
  "$extensions": {
    "org.umn-gopher-assistant.meta": {
      "name": "Campus Field Guide",
      "version": "1.0.0",
      "independenceNotice": "Project-authored tokens; no University of Minnesota brand assets or official identity claims.",
      "specification": "https://www.designtokens.org/tr/2025.10/format/"
