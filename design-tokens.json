  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": ["Georgia", "Times New Roman", "serif"]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Inter",
        "ui-sans-serif",
        "system-ui",
        "-apple-system",
        "BlinkMacSystemFont",
        "Segoe UI",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["SFMono-Regular", "Consolas", "Liberation Mono", "monospace"]
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": {
          "value": 0.75,
          "unit": "rem"
        }
      },
      "sm": {
        "$value": {
          "value": 0.875,
          "unit": "rem"
        }
      },
      "md": {
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "lg": {
        "$value": {
          "value": 1.125,
          "unit": "rem"
        }
      },
      "xl": {
        "$value": {
          "value": 1.5,
          "unit": "rem"
        }
      },
      "2xl": {
        "$value": {
          "value": 2,
          "unit": "rem"
        }
      },
      "3xl": {
        "$value": {
          "value": 3,
          "unit": "rem"
        }
      }
    },
    "lineHeight": {
      "$type": "number",
      "tight": {
        "$value": 1.15
      },
      "body": {
        "$value": 1.55
      },
      "loose": {
        "$value": 1.75
      }
    }
  },
  "space": {
    "0": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "1": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    },
    "2": {
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    "3": {
      "$value": {
        "value": 0.75,
        "unit": "rem"
      }
    },
    "4": {
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "6": {
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    },
    "8": {
      "$value": {
        "value": 2,
        "unit": "rem"
      }
    },
    "12": {
      "$value": {
        "value": 3,
        "unit": "rem"
      }
    },
    "16": {
      "$value": {
        "value": 4,
        "unit": "rem"
      }
    },
    "$type": "dimension"
  },
  "radius": {
    "$type": "dimension",
    "sharp": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "control": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    },
    "panel": {
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    "dialog": {
      "$value": {
        "value": 0.75,
        "unit": "rem"
      }
    },
    "round": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "low": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0.058824, 0.129412, 0.109804],
          "alpha": 0.1,
          "hex": "#0F211C"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 1,
          "unit": "px"
        },
        "blur": {
          "value": 2,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "medium": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0.058824, 0.129412, 0.109804],
          "alpha": 0.14,
          "hex": "#0F211C"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 10,
          "unit": "px"
        },
        "blur": {
          "value": 28,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "high": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0.031373, 0.078431, 0.066667],
          "alpha": 0.24,
          "hex": "#081411"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 24,
          "unit": "px"
        },
        "blur": {
          "value": 60,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 40,
        "unit": "rem"
      }
    },
    "md": {
      "$value": {
        "value": 52,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 72,
        "unit": "rem"
      }
    },
    "xl": {
      "$value": {
        "value": 90,
        "unit": "rem"
      }
    }
  },
  "motion": {
    "fast": {
      "$type": "duration",
      "$value": {
        "value": 120,
        "unit": "ms"
      }
    },
    "normal": {
      "$type": "duration",
      "$value": {
        "value": 200,
        "unit": "ms"
      }
    },
    "slow": {
      "$type": "duration",
      "$value": {
        "value": 320,
        "unit": "ms"
      }
    },
    "ease": {
      "$type": "cubicBezier",
      "$value": [0.2, 0.8, 0.2, 1]
    }
  },
  "target": {
    "$type": "dimension",
    "minimum": {
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    },
    "primary": {
      "$value": {
        "value": 2.75,
        "unit": "rem"
      }
    }
  },
  "focus": {
    "$type": "dimension",
    "width": {
      "$value": {
        "value": 3,
        "unit": "px"
      }
    },
    "offset": {
      "$value": {
        "value": 3,
        "unit": "px"
      }
    }
  }
}
