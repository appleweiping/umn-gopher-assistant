  "color": {
    "$type": "color",
    "light": {
      "canvas": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.956863, 0.945098, 0.909804],
          "hex": "#F4F1E8"
        }
      },
      "surface": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 0.988235, 0.960784],
          "hex": "#FFFCF5"
        }
      },
      "surfaceRaised": {
        "$value": {
