{
  "realm": "gopher-assistant-dev",
  "displayName": "Campus Assistant Local Development",
  "attributes": {
    "gopher.assistant.realm-revision": "2026-08-03.1"
  },
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "bruteForceProtected": true,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "clientProfiles": {
    "profiles": [
      {
        "name": "gopher-strict-dpop-code-binding",
        "description": "Requires every public OIDC authorization-code flow to bind its code to the submitted dpop_jkt thumbprint",
        "executors": [
          {
            "executor": "dpop-bind-enforcer",
            "configuration": {
              "auto-configure": "false",
              "enforce-authorization-code-binding-to-dpop": "true",
              "allow-only-refresh-token-binding": "false"
            }
          }
        ]
      }
    ]
  },
  "clientPolicies": {
    "policies": [
      {
        "name": "Gopher public OIDC DPoP binding",
        "description": "Applies strict DPoP authorization-code binding to the web and MCP public clients; the CLI remains a DPoP-bound device-flow client",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-type",
            "configuration": {
              "protocol": "openid-connect"
            }
          },
          {
            "condition": "client-access-type",
            "configuration": {
              "type": ["public"]
            }
          }
        ],
        "profiles": ["gopher-strict-dpop-code-binding"]
      }
    ]
  },
  "roles": {
    "realm": [
      {
        "name": "anonymous",
        "description": "Authorization vocabulary for unauthenticated product access; not assigned to tokens"
      },
      {
        "name": "visitor",
        "description": "Authenticated local visitor with no campus verification claim"
      },
      {
        "name": "campus-verified",
        "description": "Synthetic local role used to test campus verification boundaries"
      },
      {
        "name": "moderator",
        "description": "Synthetic local community moderation role"
      },
      {
        "name": "admin",
        "description": "Synthetic local platform administration role"
      },
      {
        "name": "security-reviewer",
        "description": "Synthetic local role for dual-control security review"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "gopher-api-audience",
      "description": "Adds the local API audience to access tokens",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "gopher-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "gopher-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    },
    {
      "name": "gopher-mcp-audience",
      "description": "Adds only the local canonical MCP resource audience to access tokens",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "gopher-mcp-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "http://127.0.0.1:4100/mcp",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    },
    {
      "name": "gopher-platform-roles",
      "description": "Adds realm roles without Keycloak's broad audience-resolve mapper",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "gopher-platform-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "gopher-platform-subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "lightweight.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "campus:read",
      "description": "Read campus-scoped public and approved data",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "campus:write",
      "description": "Modify reviewed campus-scoped metadata",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "personal:read",
      "description": "Read the authenticated user's private records",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "personal:write",
      "description": "Modify the authenticated user's private records",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "community:read",
      "description": "Read authenticated community resources",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "community:write",
      "description": "Create or moderate community resources",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "messages:read",
      "description": "Read private messages for the authenticated user",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "messages:write",
      "description": "Send private messages as the authenticated user",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "world:read",
      "description": "Read authenticated world-session resources",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "world:write",
      "description": "Join or publish to authorized world sessions",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "admin:read",
      "description": "Read administrative review resources",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "admin:write",
      "description": "Modify administrative policy resources",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    }
  ],
  "clients": [
    {
      "clientId": "gopher-web",
      "name": "Campus Assistant Local Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "fullScopeAllowed": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/auth/callback", "http://127.0.0.1:3000/auth/callback"],
      "webOrigins": ["http://localhost:3000", "http://127.0.0.1:3000"],
      "attributes": {
        "access.token.header.type.rfc9068": "true",
        "dpop.bound.access.tokens": "true",
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/##http://127.0.0.1:3000/"
      },
      "defaultClientScopes": ["gopher-platform-roles", "gopher-api-audience", "campus:read"],
      "optionalClientScopes": ["personal:read", "personal:write"]
    },
    {
      "clientId": "gopher-cli",
      "name": "Campus Assistant Local CLI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "fullScopeAllowed": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "access.token.header.type.rfc9068": "true",
        "dpop.bound.access.tokens": "true",
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "defaultClientScopes": ["gopher-platform-roles", "gopher-api-audience", "campus:read"],
      "optionalClientScopes": ["offline_access"]
    },
    {
      "clientId": "gopher-mcp",
      "name": "Campus Assistant Local MCP Authorization Client",
      "description": "Local DPoP-bound PKCE client with a fixed MCP audience; Keycloak 26.7.0 does not implement RFC 8707 resource indicators",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "fullScopeAllowed": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://127.0.0.1:4100/oauth/callback"],
      "webOrigins": ["http://127.0.0.1:4100"],
      "attributes": {
        "access.token.header.type.rfc9068": "true",
        "dpop.bound.access.tokens": "true",
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:4100/"
      },
      "defaultClientScopes": ["gopher-platform-roles", "gopher-mcp-audience", "campus:read"],
      "optionalClientScopes": []
    },
    {
      "clientId": "gopher-api",
      "name": "Campus Assistant Local API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "fullScopeAllowed": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [],
      "optionalClientScopes": []
    }
  ],
  "identityProviders": [],
  "users": []
}
