COMPOSE_PROJECT_NAME=gopher-assistant

# Local development values only. Use a secret manager for every shared environment.
POSTGRES_USER=gopher
POSTGRES_PASSWORD=local-postgres-password-only
POSTGRES_DB=gopher

KEYCLOAK_ADMIN=dev-admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin-password-only

REDIS_PASSWORD=local-redis-password-only
NATS_USER=gopher
NATS_PASSWORD=local-nats-password-only
MEILI_MASTER_KEY=local-meilisearch-master-key-only

MINIO_ROOT_USER=dev-minio
MINIO_ROOT_PASSWORD=local-minio-password-only

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=local-livekit-secret-with-at-least-32-characters

OPENBAO_DEV_ROOT_TOKEN_ID=local-openbao-root-token-only
