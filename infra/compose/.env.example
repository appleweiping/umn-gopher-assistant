COMPOSE_PROJECT_NAME=gopher-assistant
COMPOSE_BIND_ADDRESS=127.0.0.1

# Local development values only. Use a secret manager for every shared environment.
# API_CATALOG_CURSOR_HMAC_KEY is optional for local development and mandatory in production.
# Generate canonical base64url for 32 random bytes, for example:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Never commit or reuse the generated value.
# API_CATALOG_CURSOR_HMAC_KEY=
# API_AI_RATE_LIMIT_HMAC_KEY=
# API_AI_KNOWLEDGE_HMAC_KEY and AI_KNOWLEDGE_SERVICE_HMAC_KEY are the exact
# same shared key for Core-to-retrieval HMAC authentication. The checked-in
# value is development-only; generate a fresh independent 32-to-64-byte key
# for every shared environment.
API_AI_KNOWLEDGE_HMAC_KEY=ZGV2ZWxvcG1lbnQtb25seS1haS1zZXJ2aWNlLWhtYWMta2V5LXYx # gitleaks:allow -- fixed local-only development key
AI_KNOWLEDGE_SERVICE_HMAC_KEY=ZGV2ZWxvcG1lbnQtb25seS1haS1zZXJ2aWNlLWhtYWMta2V5LXYx # gitleaks:allow -- fixed local-only development key
# GOPHER_AI_SESSION_COOKIE_HMAC_KEY signs the Web-only anonymous AI cookie.
# GOPHER_AI_INGRESS_ASSERTION_HMAC_KEY is shared only by the trusted edge and
# Web BFF to assert an opaque privacy-network token. The edge must strip and
# overwrite all X-Gopher-Ingress-AI-* request headers.
# INTERNAL_AI_BFF_PROOF_HMAC_KEY is the exact shared value injected into both
# the Web BFF and Core API. All HMAC keys must be independently generated.
# GOPHER_AI_SESSION_COOKIE_HMAC_KEY=
# GOPHER_AI_INGRESS_ASSERTION_HMAC_KEY=
# INTERNAL_AI_BFF_PROOF_HMAC_KEY=
# Forwarding headers are ignored unless every trusted reverse-proxy network is
# listed explicitly. Never use the removed TRUST_PROXY=true shortcut.
# API_TRUSTED_PROXY_CIDRS=10.0.0.0/8,fd00::/8
# The API defaults below are loopback-only development endpoints. Shared and
# production environments must provide HTTPS AI and rediss URLs explicitly.
API_AI_KNOWLEDGE_URL=http://127.0.0.1:8100
API_AI_REDIS_URL=redis://:local-redis-password-only@127.0.0.1:6379
# The reader and sync worker intentionally use distinct least-privilege roles.
# Set complete, percent-encoded URLs when any local credential below changes.
AI_KNOWLEDGE_READER_DATABASE_URL=postgresql://gopher_ai_reader:local-ai-reader-password-only@postgres:5432/gopher
AI_KNOWLEDGE_SYNC_DATABASE_URL=postgresql://gopher_ai_sync:local-ai-sync-password-only@postgres:5432/gopher
API_AI_RATE_LIMIT_CLIENT=12
API_AI_RATE_LIMIT_NETWORK=120
API_AI_RATE_LIMIT_GLOBAL=600
API_AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_KNOWLEDGE_ENABLED=true
AI_KNOWLEDGE_PORT=8100
AI_KNOWLEDGE_DATABASE_POOL_MIN_SIZE=1
AI_KNOWLEDGE_DATABASE_POOL_MAX_SIZE=10
AI_KNOWLEDGE_DATABASE_POOL_WAIT_SECONDS=3
AI_KNOWLEDGE_SNAPSHOT_CACHE_TTL_SECONDS=30
AI_KNOWLEDGE_REVISION_CHECK_INTERVAL_SECONDS=1
POSTGRES_USER=gopher
POSTGRES_PASSWORD=local-postgres-password-only
POSTGRES_DB=gopher
POSTGRES_PORT=5432
# POSTGRES_USER is the local bootstrap/migration owner. No runtime service uses
# it. These checked-in defaults are intentionally local-only; shared and
# production environments must inject independent secret-manager credentials.
AI_KNOWLEDGE_READER_DB_USER=gopher_ai_reader
AI_KNOWLEDGE_READER_DB_PASSWORD=local-ai-reader-password-only
AI_KNOWLEDGE_SYNC_DB_USER=gopher_ai_sync
AI_KNOWLEDGE_SYNC_DB_PASSWORD=local-ai-sync-password-only
DATABASE_URL=postgres://gopher:local-postgres-password-only@127.0.0.1:5432/gopher

KEYCLOAK_ADMIN=dev-admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin-password-only
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=gopher_keycloak
KEYCLOAK_DB_PASSWORD=local-keycloak-password-only

REDIS_PASSWORD=local-redis-password-only
NATS_USER=gopher
NATS_PASSWORD=local-nats-password-only
MEILI_MASTER_KEY=local-meilisearch-master-key-only

MINIO_ROOT_USER=dev-minio
MINIO_ROOT_PASSWORD=local-minio-password-only

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=local-livekit-secret-with-at-least-32-characters

OPENBAO_DEV_ROOT_TOKEN_ID=local-openbao-root-token-only
