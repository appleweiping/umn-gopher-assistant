{
  "name": "@umn-gopher-assistant/mcp-server",
  "version": "0.1.0",
  "description": "OAuth-protected remote Streamable HTTP MCP server for the campus assistant",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@umn-gopher-assistant/contracts": "workspace:*",
    "@umn-gopher-assistant/sdk": "workspace:*",
    "jose": "6.2.11",
    "redis": "6.2.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
