{
  "name": "@umn-gopher-assistant/cli",
  "version": "0.1.0",
  "description": "Secure, OpenAPI-derived command-line client for UMN Gopher Assistant",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "uga": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.build.json && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@umn-gopher-assistant/sdk": "workspace:*",
    "commander": "15.0.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "jose": "6.2.9",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
