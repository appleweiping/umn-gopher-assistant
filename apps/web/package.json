{
  "name": "@umn-gopher-assistant/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node ./scripts/build-vault-worker.mjs && next build --webpack",
    "clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\"",
    "predev": "node ./scripts/build-vault-worker.mjs",
    "dev": "next dev",
    "lint": "eslint .",
    "smoke:identity:device": "node scripts/smoke-identity-device.mjs",
    "start": "next start",
    "test": "vitest run --passWithNoTests && node --test scripts/smoke-identity-device.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:identity:device": "node --test scripts/smoke-identity-device.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@umn-gopher-assistant/config": "workspace:*",
    "@umn-gopher-assistant/contracts": "workspace:*",
    "@umn-gopher-assistant/crypto": "workspace:*",
    "jose": "6.2.11",
    "next": "16.3.4",
    "next-intl": "4.14.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redis": "6.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
